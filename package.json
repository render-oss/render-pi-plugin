{
  "name": "@render/pi-render",
  "version": "0.1.0",
  "description": "Render integration for the Pi coding agent — deployment skills and lazy hosted MCP access.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/render-lab/render-pi-plugin.git"
  },
  "homepage": "https://github.com/render-lab/render-pi-plugin#readme",
  "bugs": {
    "url": "https://github.com/render-lab/render-pi-plugin/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "sync-skills": "bash scripts/sync-skills.sh"
  },
  "dependencies": {
    "pi-mcp-adapter": "2.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
